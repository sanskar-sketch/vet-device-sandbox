{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vitarus-live",
      "url": "https://vitarus.onrender.com"
    },
    {
      "name": "vitarus-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "vitarus-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "server/index.js"
      ],
      "port": 4173
    }
  ]
}
